# CELL 4: Multi-GPU QLoRA Fine-Tuning on 3,000 Samples
# ==========================================
import os
import json
import torch
from PIL import Image

from torch.utils.data import Dataset
from transformers import AutoProcessor, Qwen2_5_VLForConditionalGeneration, TrainingArguments, Trainer, BitsAndBytesConfig
from peft import LoraConfig, get_peft_model

class EODataset(Dataset):
    def __init__(self, jsonl_path, processor):
        self.processor = processor
        self.records = [json.loads(line) for line in open(jsonl_path, "r") if line.strip()]

    def __len__(self): return len(self.records)

    def __getitem__(self, idx):
        messages = self.records[idx]["messages"]
        text = self.processor.apply_chat_template(messages, tokenize=False, add_generation_prompt=False)
        images = [c["image"] for msg in messages for c in msg.get("content", []) if c.get("type") == "image"]
        inputs = self.processor(text=[text], images=images if images else None, padding=True, return_tensors="pt")
        item = {k: v.squeeze(0) if k in ["input_ids", "attention_mask"] else v for k, v in inputs.items()}
        item["labels"] = item["input_ids"].clone()
        return item

class DataCollator:
    def __init__(self, processor): self.pad_id = processor.tokenizer.pad_token_id or 151643
    def __call__(self, batch):
        b_dict = {
            "input_ids": torch.nn.utils.rnn.pad_sequence([i["input_ids"] for i in batch], batch_first=True, padding_value=self.pad_id),
            "attention_mask": torch.nn.utils.rnn.pad_sequence([i["attention_mask"] for i in batch], batch_first=True, padding_value=0),
            "labels": torch.nn.utils.rnn.pad_sequence([i["labels"] for i in batch], batch_first=True, padding_value=-100),
        }
        if "pixel_values" in batch[0]: b_dict["pixel_values"] = torch.cat([i["pixel_values"] for i in batch], dim=0)
        if "image_grid_thw" in batch[0]: b_dict["image_grid_thw"] = torch.cat([i["image_grid_thw"] if i["image_grid_thw"].ndim==2 else i["image_grid_thw"].unsqueeze(0) for i in batch], dim=0)
        return b_dict

quant_config = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_quant_type="nf4", bnb_4bit_use_double_quant=True, bnb_4bit_compute_dtype=torch.float16)

print("[INFO] Loading Qwen2.5-VL-3B-Instruct onto Dual T4 GPUs...")
model_id = "Qwen/Qwen2.5-VL-3B-Instruct"
model = Qwen2_5_VLForConditionalGeneration.from_pretrained(model_id, quantization_config=quant_config, device_map="auto", torch_dtype=torch.float16)
processor = AutoProcessor.from_pretrained(model_id)

if hasattr(model, "visual"):
    for p in model.visual.parameters(): p.requires_grad = False
    print("✅ Base Vision Encoder frozen.")

peft_config = LoraConfig(r=32, lora_alpha=64, lora_dropout=0.05, bias="none", task_type="CAUSAL_LM", target_modules=["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"])
model = get_peft_model(model, peft_config)

output_adapter_dir = "/kaggle/working/eo_gpt_flood_crop_adapter"
training_args = TrainingArguments(
    output_dir=output_adapter_dir,
    num_train_epochs=3,
    per_device_train_batch_size=4,
    gradient_accumulation_steps=4,
    learning_rate=1.5e-4,
    lr_scheduler_type="cosine",
    fp16=True,
    logging_steps=10,
    save_strategy="epoch",
    optim="paged_adamw_8bit",
    report_to="none",
    remove_unused_columns=False
)

trainer = Trainer(model=model, args=training_args, train_dataset=EODataset(jsonl_path, processor), data_collator=DataCollator(processor))
print("🚀 Starting Dual-Domain QLoRA Training on 3,000 Pan-India Samples...")
trainer.train()

print(f"✅ SUCCESS! 3,000 Sample Pan-India Adapter saved to: {output_adapter_dir}")
model.save_pretrained(output_adapter_dir)
processor.save_pretrained(output_adapter_dir)



