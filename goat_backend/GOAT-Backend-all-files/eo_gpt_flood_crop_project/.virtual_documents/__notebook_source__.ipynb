def create_geotiff_tile(filename, width=512, height=512, domain_type="flood", region_info=None):
    os.makedirs(os.path.dirname(filename), exist_ok=True)
    np.random.seed(abs(hash(filename)) % (2**31))

    blue = np.random.randint(400, 1200, (height, width), dtype=np.uint16)
    green = np.random.randint(600, 1600, (height, width), dtype=np.uint16)
    red = np.random.randint(400, 1400, (height, width), dtype=np.uint16)
    red_edge = np.random.randint(1500, 3000, (height, width), dtype=np.uint16)
    nir = np.random.randint(2000, 5000, (height, width), dtype=np.uint16)
    swir = np.random.randint(1000, 2500, (height, width), dtype=np.uint16)

    if domain_type == "flood":
        cx, cy, r = np.random.randint(120, 380), np.random.randint(120, 380), np.random.randint(60, 140)
        yg, xg = np.ogrid[:height, :width]
        fmask = (xg - cx)**2 + (yg - cy)**2 <= r**2
        green[fmask] = np.random.randint(1800, 2800, size=np.count_nonzero(fmask), dtype=np.uint16)
        nir[fmask] = np.random.randint(100, 400, size=np.count_nonzero(fmask), dtype=np.uint16)
    elif domain_type == "crop":
        for r in range(4):
            for c in range(4):
                rmin, rmax, cmin, cmax = r*128, (r+1)*128, c*128, (c+1)*128
                nir[rmin:rmax, cmin:cmax] = np.random.randint(4500, 7500, size=(128, 128), dtype=np.uint16)
                red[rmin:rmax, cmin:cmax] = np.random.randint(200, 600, size=(128, 128), dtype=np.uint16)

    lat = region_info.get("lat", 20.0) if region_info else 20.0
    lon = region_info.get("lon", 78.0) if region_info else 78.0
    transform = from_origin(lon, lat, 0.0001, 0.0001)

    with rasterio.open(filename, "w", driver="GTiff", height=height, width=width, count=6, dtype=np.uint16, crs="EPSG:4326", transform=transform) as dst:
        dst.write(blue, 1); dst.write(green, 2); dst.write(red, 3); dst.write(red_edge, 4); dst.write(nir, 5); dst.write(swir, 6)

    return filename

def generate_pan_india_dataset(output_dir="/kaggle/working/data/geotiff_raw", tiles_per_aoi=10):
    created = []
    for aoi in PAN_INDIA_REGIONAL_AOIS:
        for i in range(tiles_per_aoi):
            path = os.path.join(output_dir, f"S2A_{aoi['zone']}_{aoi['state'].lower().replace(' ','_')}_{aoi['type']}_{i+1:03d}.tif")
            create_geotiff_tile(path, domain_type=aoi['type'], region_info=aoi)
            created.append({"file": path, "aoi": aoi, "domain": aoi['type']})
    print(f"✅ Generated GeoTIFF satellite scenes across ALL Indian States & UTs!")
    return created

